# Copy to apps/gateway/.env for local development (that file is gitignored).
# Never put a real key in this .env.example file or in any commit.

# Required. The one Magic Canvas-owned TypeSafe/Jev key. Server-side only:
# never shipped to the desktop app, never a VITE_/client-exposed variable.
TYPESAFE_API_KEY=

# Network binding. 127.0.0.1 only accepts local connections; put a
# TLS-terminating reverse proxy in front for any non-local deployment.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# Persistent SQLite file for device tokens and request-budget counters.
GATEWAY_DB_PATH=./.data/gateway.sqlite

# Body size cap in bytes, enforced against bytes actually read from the
# request stream (not the client-supplied Content-Length).
GATEWAY_MAX_BODY_BYTES=262144

# Separate phase timeout for inbound body reads and for the complete upstream
# TypeSafe response (including its body).
GATEWAY_REQUEST_TIMEOUT_MS=15000

# Spend controls. Keep GATEWAY_GLOBAL_DAILY_LIMIT conservative: it is the
# hard ceiling on paid upstream calls per UTC day across every device.
GATEWAY_GLOBAL_DAILY_LIMIT=100
GATEWAY_DEVICE_DAILY_LIMIT=20
GATEWAY_DEVICE_HOURLY_LIMIT=5
GATEWAY_DEVICE_CONCURRENCY=1
GATEWAY_GLOBAL_CONCURRENCY=8

# Anonymous device enrollment is rate-limited by observed IP address.
GATEWAY_ENROLL_HOURLY_LIMIT_PER_IP=5
GATEWAY_ENROLL_DAILY_LIMIT_PER_IP=15

# Stops anonymous enrollment from creating unlimited records across many IPs.
GATEWAY_ENROLL_GLOBAL_DAILY_LIMIT=500
